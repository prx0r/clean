{
  "name": "@tantraloka/skia-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic Skia motion-graphics framework for Tantraloka visual packs.",
  "scripts": {
    "render": "node src/cli.mjs render",
    "poster": "node src/cli.mjs poster",
    "validate": "node src/cli.mjs validate",
    "compile:essay": "node src/cli.mjs compile-essay programs/infinite-learned-visual-program.json",
    "render:essay": "node src/cli.mjs render-essay programs/infinite-learned-visual-program.json",
    "build:song": "node tools/build-song-program.mjs && node tools/build-song-analysis.mjs",
    "audit:song-analysis": "node src/cli.mjs audit-analysis programs/song-no-singer-analysis.json",
    "audit:song": "node src/cli.mjs audit-essay programs/song-no-singer-visual-program.json",
    "compile:song": "node src/cli.mjs compile-essay programs/song-no-singer-visual-program.json",
    "render:song": "node src/cli.mjs render-essay programs/song-no-singer-visual-program.json",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.2"
  }
}
