{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tantraloka.local/schemas/capability-pack.schema.json",
  "title": "Tantraloka Skia Capability Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "description",
    "extends",
    "defaultTheme",
    "mechanisms"
  ],
  "properties": {
    "version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "description": { "type": "string", "minLength": 20, "maxLength": 1000 },
    "extends": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" }
    },
    "includeBuiltins": { "type": "boolean", "default": false },
    "defaultTheme": { "type": "string", "minLength": 3, "maxLength": 64 },
    "runtimeModule": { "type": "string", "minLength": 3, "maxLength": 300 },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "tokens"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 64 },
          "tokens": { "type": "object" }
        }
      }
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "description",
          "relations",
          "operators",
          "semanticTags",
          "motionProof"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "description": { "type": "string", "minLength": 20, "maxLength": 600 },
          "relations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "operators": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "semanticTags": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "motionProof": { "type": "string", "minLength": 20, "maxLength": 600 },
          "parameters": { "type": "object" },
          "provenance": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "description",
          "category",
          "epistemicMode",
          "semanticTags"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
          "description": { "type": "string", "minLength": 20, "maxLength": 600 },
          "category": { "type": "string", "minLength": 3, "maxLength": 80 },
          "epistemicMode": { "type": "string", "minLength": 3, "maxLength": 80 },
          "semanticTags": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "parameters": { "type": "object" },
          "provenance": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "selectionPolicy": { "type": "object" }
  }
}
