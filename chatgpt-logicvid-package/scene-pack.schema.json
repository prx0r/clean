{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tantrafiles.xyz/schemas/skia-scene-pack-1.0.json",
  "title": "Tantrāloka Skia Scene Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "theme", "seed", "render", "scenes"],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "theme": {
      "enum": ["ivoryManuscript", "whiteScientific", "midnightVellum"]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "sceneDuration"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 640,
          "maximum": 7680,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 360,
          "maximum": 4320,
          "multipleOf": 2
        },
        "fps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "sceneDuration": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 35,
          "default": 16
        },
        "preset": {
          "enum": ["ultrafast", "superfast", "veryfast", "faster", "fast", "medium", "slow"],
          "default": "medium"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "subtitle", "term", "devanagari", "motif"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,31}$"
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "subtitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "devanagari": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "motif": {
          "enum": [
            "composition",
            "heart-lattice",
            "attention-lens",
            "phoneme-forge",
            "reflexive-mirror",
            "return-current",
            "closing-heart-seal"
          ]
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": [
                  "orb",
                  "ring",
                  "ellipse",
                  "lotus",
                  "label",
                  "silhouette",
                  "polygon",
                  "path",
                  "bezier",
                  "orbit-nodes",
                  "radial-words",
                  "grid"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "duration": {
          "type": "number",
          "minimum": 1,
          "maximum": 30
        },
        "theme": {
          "enum": ["ivoryManuscript", "whiteScientific", "midnightVellum"]
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accent": {
              "$ref": "#/$defs/hexColor"
            },
            "secondary": {
              "$ref": "#/$defs/hexColor"
            },
            "luminous": {
              "$ref": "#/$defs/hexColor"
            }
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
